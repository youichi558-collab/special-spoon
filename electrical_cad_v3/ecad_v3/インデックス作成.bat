@echo off
rem ================================================================
rem  カタログ検索用インデックス作成バッチ
rem  CAD(server.py)とは独立して、単体で実行できるようにしたもの。
rem  CADを起動していなくてもこのファイルをダブルクリックするだけで
rem  実行できる。CAD側は出来上がった索引を読むだけで、作成・更新はしない。
rem
rem  catalog_config.json に登録されている全カタログをまとめて
rem  インデックス化する(差分更新: 変更のないファイルはスキップされる)。
rem  フォルダが大きい場合、初回は数分かかることがある。
rem ================================================================
chcp 65001 >nul
cd /d "%~dp0"

echo ============================================
echo  カタログ検索インデックス作成
echo ============================================
echo.

py -m pip show pdfplumber >nul 2>&1
if errorlevel 1 (
    echo pdfplumberが未インストールです。
    echo 先に次のコマンドを実行してください:
    echo     py -m pip install pdfplumber
    echo.
    pause
    exit /b 1
)

py tools\catalog\catalog_index.py build-all
echo.
echo ============================================
echo  完了しました。ウィンドウを閉じてください。
echo ============================================
pause
